# ============================================================
# BusinessHub Front-End — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing secrets.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Public-facing URL of this Next.js app (no trailing slash)
# Used for CORS, NextAuth callbacks, and OG image generation
NEXT_PUBLIC_DOMAIN="http://localhost:3001"

# ------------------------------------------------------------
# Authentication (NextAuth v5 / Auth.js)
# ------------------------------------------------------------

# Secret used to sign JWTs and session cookies.
# Generate with: openssl rand -base64 32
# REQUIRED in production — must be at least 32 characters
NEXTAUTH_SECRET="your-secret-key-min-32-chars-long"

# ------------------------------------------------------------
# Backend API
# ------------------------------------------------------------

# Base URL for the NestJS backend API (server-side only)
# Do NOT prefix with NEXT_PUBLIC_ — this is never sent to the browser
EXTERNAL_API_URL="http://localhost:8000/api/v1"

# ------------------------------------------------------------
# Internationalization
# ------------------------------------------------------------

# Default locale served to users without a locale preference
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# Comma-separated list of supported locales
NEXT_PUBLIC_LOCALES="en,ar"

# ------------------------------------------------------------
# Contact & Social Links (displayed in footer / about page)
# ------------------------------------------------------------

NEXT_PUBLIC_PHONE="+966500000000"
NEXT_PUBLIC_EMAIL="info@businesshub.com.sa"
NEXT_PUBLIC_LINKEDIN="https://www.linkedin.com/company/businesss-hub/"
NEXT_PUBLIC_X="https://x.com/businesss_hub"
NEXT_PUBLIC_INSTAGRAM="https://www.instagram.com/businesss_hub/"
NEXT_PUBLIC_ADDRESS="كورنيش وادي العقيق, Al Wabra, Madinah 42371, Saudi Arabia"
NEXT_PUBLIC_MAP_URL="https://maps.app.goo.gl/exampleMapLink"
